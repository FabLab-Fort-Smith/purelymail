{
  "name": "@fablabfortsmith/purelymail-tui",
  "version": "0.2.0",
  "description": "Unofficial terminal UI (TUI) for PurelyMail multi-account/organization management. Built on @fablabfortsmith/purelymail-core.",
  "type": "module",
  "license": "MIT",
  "author": "Fab Lab Fort Smith",
  "homepage": "https://github.com/FabLab-Fort-Smith/purelymail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabLab-Fort-Smith/purelymail.git",
    "directory": "packages/tui"
  },
  "bugs": {
    "url": "https://github.com/FabLab-Fort-Smith/purelymail/issues"
  },
  "keywords": [
    "purelymail",
    "email",
    "tui",
    "terminal",
    "ink"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type-note": "Unofficial. Not affiliated with or endorsed by PurelyMail.",
  "bin": {
    "purelymail-tui": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fablabfortsmith/purelymail-config": "workspace:*",
    "@fablabfortsmith/purelymail-core": "workspace:*",
    "ink": "5.1.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "ink-testing-library": "4.0.0"
  }
}
