{
  "name": "@fablabfortsmith/purelymail-config",
  "version": "0.3.0",
  "description": "Profile/config loading for the PurelyMail toolkit: reads the non-secret TOML config into a core ProfileRegistry with env-var / OS-keychain token providers. Shared by the CLI and TUI.",
  "type": "module",
  "license": "MIT",
  "author": "Fab Lab Fort Smith",
  "homepage": "https://github.com/FabLab-Fort-Smith/purelymail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabLab-Fort-Smith/purelymail.git",
    "directory": "packages/config"
  },
  "bugs": {
    "url": "https://github.com/FabLab-Fort-Smith/purelymail/issues"
  },
  "keywords": [
    "purelymail",
    "config",
    "toml",
    "keychain"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type-note": "Unofficial. Not affiliated with or endorsed by PurelyMail.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fablabfortsmith/purelymail-core": "workspace:*",
    "smol-toml": "1.7.1",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  }
}
