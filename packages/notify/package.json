{
  "name": "@fablabfortsmith/purelymail-notify",
  "version": "0.2.0",
  "description": "Email notifications for the PurelyMail toolkit: an SMTP mailer (nodemailer) + a new-account welcome template. Shared by the CLI and TUI.",
  "type": "module",
  "license": "MIT",
  "author": "Fab Lab Fort Smith",
  "homepage": "https://github.com/FabLab-Fort-Smith/purelymail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FabLab-Fort-Smith/purelymail.git",
    "directory": "packages/notify"
  },
  "bugs": {
    "url": "https://github.com/FabLab-Fort-Smith/purelymail/issues"
  },
  "keywords": [
    "purelymail",
    "email",
    "smtp",
    "notifications",
    "nodemailer"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "type-note": "Unofficial. Not affiliated with or endorsed by PurelyMail.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "nodemailer": "6.9.16"
  },
  "devDependencies": {
    "@types/nodemailer": "6.4.17"
  }
}
