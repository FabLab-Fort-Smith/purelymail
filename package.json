{
  "name": "@fablabfortsmith/purelymail-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for the PurelyMail core library and CLI (unofficial).",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "docs": "typedoc",
    "audit": "pnpm audit --audit-level=high",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:cov && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.18.0",
    "eslint-plugin-jsdoc": "50.6.1",
    "prettier": "3.4.2",
    "tsup": "8.3.5",
    "typedoc": "0.27.6",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.9"
  }
}
