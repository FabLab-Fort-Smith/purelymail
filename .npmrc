# Supply-chain hardening (std-supplychain)
# Pin exact versions on install so lockfile + node_modules stay reproducible.
save-exact=true
# Fail install if the lockfile would need changing in CI.
# (CI runs `pnpm install --frozen-lockfile`.)
engine-strict=true
# Publish provenance attestations from CI (SLSA). No effect locally.
provenance=false
