# PurelyMail CLI / core — local environment (placeholders ONLY, never real secrets).
# Copy to `.env` (git-ignored) for local dev, or export these in your shell/CI.
#
# Obtain a token: sign in at https://purelymail.com -> account settings ->
# "Refresh API Key" -> copy. Treat it as a password (workflow-secrets).

# Default single-account token. Used when no --profile is selected and a profile
# does not name its own token env var.
PURELYMAIL_API_TOKEN=

# Multi-account: each profile in purelymail.config.toml may name its own env var,
# e.g. tokenEnv = "PURELYMAIL_TOKEN_ACME". Define those here / in your CI secrets:
# PURELYMAIL_TOKEN_ACME=
# PURELYMAIL_TOKEN_CLIENTB=

# Optional: override the API base URL (must be https). Defaults to
# https://purelymail.com. Useful for a local/staging mock only.
# PURELYMAIL_BASE_URL=https://purelymail.com

# Optional: request timeout in milliseconds (default 30000).
# PURELYMAIL_TIMEOUT_MS=30000

# Optional: SMTP password for the `[notify]` welcome-email feature (CLI
# `users create --notify` / the TUI create form). Only needed if you configure a
# `[notify]` section. The password is a secret — sourced from this env var (or
# `passwordEnv`), or the OS keychain (`keychain = true`); never stored in the
# config file. Override the var name per `[notify].passwordEnv`.
# PURELYMAIL_SMTP_PASSWORD=
